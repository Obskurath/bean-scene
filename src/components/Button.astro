---
type Props = {
  href?: string;
  type?: "button" | "submit" | "reset";
  width?: string;
  height?: string;
  fontWeight?: string;
  class?: string;
};

const {
  href,
  type = "button",
  width,
  height,
  fontWeight,
  class: className = "",
} = Astro.props as Props;

const baseStyles =
  "btn-color inline-flex items-center justify-center rounded-[24px] px-4 py-[6px] text-sm text-slate-950 transition duration-200 ease-out hover:brightness-102 hover:shadow-[0_8px_16px_rgba(249,192,106,0.22)] font-heading shadow-md";

const style = [
  width ? `width: ${width};` : "",
  height ? `height: ${height};` : "",
  fontWeight ? `font-weight: ${fontWeight};` : "",
]
  .filter(Boolean)
  .join(" ");
---

{
  href ? (
    <a href={href} class={`${baseStyles} ${className}`} style={style}>
      <slot />
    </a>
  ) : (
    <button type={type} class={`${baseStyles} ${className}`} style={style}>
      <slot />
    </button>
  )
}
