---
type Props = {
  href?: string;
  type?: "button" | "submit" | "reset";
  width?: string;
  fontWeight?: string;
  class?: string;
};

const {
  href,
  type = "button",
  width,
  fontWeight,
  class: className = "",
} = Astro.props as Props;

const baseStyles =
  "btn-color inline-flex items-center justify-center rounded-[24px] h-[48px] w-fit px-6 py-[6px] text-sm text-slate-950 transition duration-200 ease-out hover:brightness-102 hover:shadow-[0_8px_16px_rgba(249,192,106,0.22)] font-heading shadow-md cursor-pointer";
---

{
  href ? (
    <a
      href={href}
      class:list={[baseStyles, className]}
      style={{ width: width, fontWeight: fontWeight }}
    >
      <slot />
    </a>
  ) : (
    <button
      type={type}
      class:list={[baseStyles, className]}
      style={{ width: width, fontWeight: fontWeight }}
    >
      <slot />
    </button>
  )
}
