---
import Button from "./Button.astro";

type NavLink = {
  href: string;
  label: string;
};

type Props = {
  title?: string;
  href?: string;
  links?: NavLink[];
  class?: string;
};

const {
  title = "Bean Scene",
  href = "/",
  links = [
    { href: "/", label: "Home" },
    { href: "/#Discover", label: "Discover" },
    { href: "/#Menu", label: "Menu" },
    { href: "/#About", label: "About Us" },
  ],
  class: className = "",
} = Astro.props as Props;
---

<header
  id="site-header"
  class={`fixed top-0 z-50 w-full transition-all duration-300 ${className}`}
>
  <div
    id="header-container"
    class="flex w-full items-center px-6 py-4 sm:px-10 lg:px-16 transition-all duration-300"
  >
    <a
      href={href}
      id="header-logo"
      class="shrink-0 text-[30px] text-white font-script transition-all duration-300"
    >
      {title}
    </a>

    <div class="flex flex-1 items-center justify-center">
      <nav
        aria-label="Primary"
        class="flex items-center gap-6 lg:gap-14 max-md:hidden"
      >
        {
          links.map((link) => (
            <a
              href={link.href}
              class="nav-link text-sm text-slate-300 font-medium transition-colors duration-300 hover:text-white font-heading"
            >
              {link.label}
            </a>
          ))
        }
      </nav>
    </div>

    <div class="flex shrink-0 items-center justify-end gap-3">
      <button
        id="open-cart-drawer-btn"
        type="button"
        style="display: none;"
        class="relative inline-flex h-9 w-9 items-center justify-center rounded-full bg-[#F9C06A]/20 text-(--filler-color) border border-[#F9C06A]/40 transition-all duration-300 hover:bg-[#F9C06A]/30 cursor-pointer shadow-sm"
        aria-label="Shopping Cart"
      >
        <svg
          xmlns="http://www.w3.org/2000/svg"
          class="w-4 h-4"
          fill="none"
          viewBox="0 0 24 24"
          stroke="currentColor"
          stroke-width="2.5"
        >
          <path
            stroke-linecap="round"
            stroke-linejoin="round"
            d="M16 11V7a4 4 0 00-8 0v4M5 9h14l1 12H4L5 9z"></path>
        </svg>
        <span
          id="header-cart-badge"
          class="absolute -top-1 -right-1 flex h-5 min-w-[20px] items-center justify-center rounded-full btn-color px-1 text-[10px] font-bold text-(--filler-color) shadow-md border-2 border-white hidden font-heading"
          >0</span
        >
      </button>

      <div
        id="auth-container"
        class="flex items-center opacity-0 transition-opacity duration-200"
      >
        <div id="auth-actions" class="flex items-center gap-3">
          <a
            href="/sign-in"
            class="nav-link text-sm text-slate-300 font-medium transition-colors duration-300 hover:text-white font-heading"
          >
            Sign In
          </a>
          <Button href="/sign-up" class="h-9 px-3.5 text-xs"> Sign Up </Button>
        </div>

        <div id="user-menu-wrapper" class="relative hidden">
          <button
            id="user-menu-button"
            type="button"
            class="btn-color inline-flex h-9 w-9 items-center justify-center rounded-full border-2 border-(--btn-color) text-base font-semibold text-slate-950 shadow-md transition duration-200 ease-out hover:brightness-102 cursor-pointer"
            aria-label="Open user menu"
          >
            <span id="user-initial">U</span>
          </button>

          <div
            id="user-menu"
            class="absolute right-0 mt-2 hidden w-44 rounded-2xl border border-(--border-color)/40 bg-white p-2 shadow-xl"
          >
            <a
              href="/profile"
              class="block w-full rounded-xl px-3 py-2 text-left text-sm text-(--header-color) transition hover:bg-(--filler-color)"
            >
              Profile
            </a>
            <a
              href="/orders"
              class="block w-full rounded-xl px-3 py-2 text-left text-sm text-(--header-color) transition hover:bg-(--filler-color)"
            >
              Orders
            </a>
            <button
              id="sign-out-button"
              type="button"
              class="block w-full rounded-xl px-3 py-2 text-left text-sm text-(--header-color) transition hover:bg-(--filler-color) cursor-pointer"
            >
              Sign out
            </button>
          </div>
        </div>
      </div>
    </div>
  </div>
</header>

<script>
  import { initHeader } from "../scripts/ui/header";

  initHeader();
</script>
