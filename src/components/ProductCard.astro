---
import { Image } from "astro:assets";
import type { ImageMetadata } from "astro";

export interface Props {
  product: {
    id: string | number;
    name: string;
    description: string;
    price: number;
    image: string | ImageMetadata;
  };
}

const { product } = Astro.props;

const formattedPrice = new Intl.NumberFormat("en-US", {
  style: "currency",
  currency: "USD",
  minimumFractionDigits: 2,
}).format(product.price);

const imageSrc =
  typeof product.image === "string" ? product.image : product.image.src;
---

<article
  class="bg-(--filler-color) border border-(--border-color) overflow-hidden flex flex-col items-center text-center rounded-2xl"
>
  <div class="w-full">
    {
      typeof product.image === "string" ? (
        <img
          src={product.image}
          alt={`Imagen de ${product.name}`}
          width="280"
          height="222"
          class="w-full h-full object-cover rounded-b-sm"
        />
      ) : (
        <Image
          src={product.image}
          alt={`Imagen de ${product.name}`}
          width={280}
          height={222}
          class="w-full h-full object-cover rounded-b-sm"
        />
      )
    }
  </div>

  <div class="p-6 flex flex-col items-center w-full max-sm:p-2">
    <h3 class="text-xl font-bold text-(--header-color)">
      {product.name}
    </h3>

    <p class="text-gray-600 text-sm mb-3 max-sm:hidden">
      {product.description}
    </p>

    <span class="text-lg font-bold text-(--header-color) mb-4 max-sm:mb-2">
      {formattedPrice}
    </span>

    <button
      type="button"
      class="add-to-cart-btn btn-color text-slate-950 font-semibold px-6 py-2.5 rounded-full shadow-md transition font-heading opacity-50 cursor-not-allowed"
      disabled
      data-id={product.id}
      data-name={product.name}
      data-price={product.price}
      data-image={imageSrc}
    >
      Add to cart
    </button>
  </div>
</article>

<script>
  import { supabase } from "../lib/supabase";
  import { addToCart } from "../store/cartStore";

  const buttons = document.querySelectorAll(".add-to-cart-btn");

  const syncButtonsState = (hasSession: boolean) => {
    buttons.forEach((btn) => {
      const button = btn as HTMLButtonElement;
      if (hasSession) {
        button.disabled = false;
        button.classList.remove("opacity-50", "cursor-not-allowed");
        button.classList.add("hover:brightness-105", "cursor-pointer");
      } else {
        button.disabled = true;
        button.classList.add("opacity-50", "cursor-not-allowed");
        button.classList.remove("hover:brightness-105", "cursor-pointer");
      }
    });
  };

  supabase.auth.getSession().then(({ data: { session } }) => {
    syncButtonsState(!!session?.user);
  });

  supabase.auth.onAuthStateChange((_event, session) => {
    syncButtonsState(!!session?.user);
  });

  buttons.forEach((button) => {
    button.addEventListener("click", (e) => {
      const target = e.currentTarget as HTMLButtonElement;

      if (target.disabled) return;

      const product = {
        id: target.getAttribute("data-id")!,
        name: target.getAttribute("data-name")!,
        price: Number(target.getAttribute("data-price")!),
        image: target.getAttribute("data-image")!,
      };

      addToCart(product);

      const originalText = target.innerText;
      target.innerText = "Added! ✓";
      setTimeout(() => {
        target.innerText = originalText;
      }, 1500);
    });
  });
</script>
