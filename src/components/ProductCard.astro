---
import { Image } from "astro:assets";
import Button from "./Button.astro";
import type { ImageMetadata } from "astro";

export interface Props {
  product: {
    id: string;
    name: string;
    description: string;
    price: number;
    image: ImageMetadata;
  };
}

const { product } = Astro.props;

const formattedPrice = new Intl.NumberFormat("en-US", {
  style: "currency",
  currency: "USD",
  minimumFractionDigits: 2,
}).format(product.price);
---

<article
  class="bg-(--filler-color) border border-(--border-color) overflow-hidden flex flex-col items-center text-center rounded-2xl"
>
  <div class="w-full aspect-280/222">
    <Image
      src={product.image}
      alt={`Imagen de ${product.name}`}
      class="w-full h-full object-cover rounded-b-sm"
    />
  </div>

  <div class="p-6 flex flex-col items-center w-full">
    <h3 class="text-xl font-bold text-(--header-color) mb-1 font-serif">
      {product.name}
    </h3>

    <p class="text-gray-600 text-sm mb-3">
      {product.description}
    </p>

    <span class="text-lg font-bold text-(--header-color) mb-4">
      {formattedPrice}
    </span>

    <Button fontWeight="500"> Order Now </Button>
  </div>
</article>
