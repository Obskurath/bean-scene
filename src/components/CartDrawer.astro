---

---

<div
  id="cart-overlay"
  class="fixed inset-0 bg-black/50 z-50 transition-opacity duration-300 opacity-0 pointer-events-none"
>
</div>

<div
  id="cart-drawer"
  class="fixed top-0 right-0 h-full w-full max-w-md bg-[var(--filler-color)] border-l border-[var(--border-color)] z-50 shadow-2xl transform translate-x-full transition-transform duration-300 ease-in-out flex flex-col"
>
  <div
    class="flex items-center justify-between p-4 border-b border-[var(--border-color)]"
  >
    <h2
      class="text-xl font-bold text-[var(--header-color)] flex items-center gap-2 font-heading"
    >
      Shopping Cart
      <span
        id="cart-count-badge"
        class="text-xs btn-color px-2 py-0.5 rounded-full text-slate-950 font-bold"
        >0</span
      >
    </h2>
    <button
      id="close-cart"
      class="text-[var(--text-color)] hover:text-[var(--header-color)] text-2xl font-bold p-1 cursor-pointer"
      >&times;</button
    >
  </div>

  <div id="drawer-cart-items" class="flex-1 overflow-y-auto p-4 space-y-4">
  </div>

  <div
    id="drawer-footer"
    class="p-4 border-t border-[var(--border-color)] bg-[var(--filler-color)] hidden"
  >
    <div
      class="flex justify-between items-center mb-4 text-lg font-bold text-[var(--header-color)]"
    >
      <span>Subtotal:</span>
      <span id="drawer-cart-total">$0.00</span>
    </div>

    <button
      id="drawer-checkout-btn"
      class="w-full btn-color text-slate-950 font-semibold py-3 rounded-full shadow-md transition hover:brightness-105 cursor-pointer text-center block font-heading"
    >
      Proceed to Checkout (Stripe)
    </button>
  </div>
</div>

<script>
  import { cartStore, removeFromCart, addToCart } from "../store/cartStore";

  const drawer = document.getElementById("cart-drawer");
  const overlay = document.getElementById("cart-overlay");
  const closeBtn = document.getElementById("close-cart");
  const cartItemsContainer = document.getElementById("drawer-cart-items");
  const drawerFooter = document.getElementById("drawer-footer");
  const cartTotalElement = document.getElementById("drawer-cart-total");
  const cartCountBadge = document.getElementById("cart-count-badge");

  (window as any).openCartDrawer = () => {
    drawer?.classList.remove("translate-x-full");
    overlay?.classList.remove("opacity-0", "pointer-events-none");
  };

  (window as any).closeCartDrawer = () => {
    drawer?.classList.add("translate-x-full");
    overlay?.classList.add("opacity-0", "pointer-events-none");
  };

  closeBtn?.addEventListener("click", () => (window as any).closeCartDrawer());
  overlay?.addEventListener("click", () => (window as any).closeCartDrawer());

  cartStore.subscribe((cart) => {
    if (
      !cartItemsContainer ||
      !drawerFooter ||
      !cartTotalElement ||
      !cartCountBadge
    )
      return;

    const totalItems = cart.reduce((acc, item) => acc + item.quantity, 0);
    cartCountBadge.innerText = String(totalItems);

    if (cart.length === 0) {
      cartItemsContainer.innerHTML = `
        <div class="text-center py-20 text-[var(--text-color)]">
          <p class="text-lg font-medium mb-2 font-heading">Your Cart is empty</p>
          <p class="text-sm">Add delicious coffee from the menu!</p>
        </div>
      `;
      drawerFooter.classList.add("hidden");
      return;
    }

    drawerFooter.classList.remove("hidden");
    let total = 0;

    cartItemsContainer.innerHTML = cart
      .map((item) => {
        total += item.price * item.quantity;
        return `
        <div class="flex items-center gap-3 bg-white border border-[var(--border-color)]/40 p-3 rounded-xl shadow-xs">
          <img src="${item.image}" alt="${item.name}" class="w-16 h-16 object-cover rounded-lg" />
          <div class="flex-1 min-w-0">
            <h4 class="font-bold text-[var(--header-color)] text-sm truncate font-heading">${item.name}</h4>
            <p class="text-xs text-[var(--text-color)]">$${item.price.toFixed(2)}</p>
            <div class="flex items-center gap-2 mt-2">
              <button class="drawer-decrease px-2 py-0.5 bg-gray-100 rounded text-xs font-bold cursor-pointer text-slate-800" data-id="${item.id}">-</button>
              <span class="text-xs font-bold text-slate-800">${item.quantity}</span>
              <button class="drawer-increase px-2 py-0.5 bg-gray-100 rounded text-xs font-bold cursor-pointer text-slate-800" data-id="${item.id}">+</button>
            </div>
          </div>
          <div class="text-right font-bold text-sm text-[var(--header-color)]">
            $${(item.price * item.quantity).toFixed(2)}
          </div>
        </div>
      `;
      })
      .join("");

    cartTotalElement.innerText = `$${total.toFixed(2)}`;

    document.querySelectorAll(".drawer-decrease").forEach((btn) => {
      btn.addEventListener("click", (e) => {
        const id = (e.currentTarget as HTMLElement).dataset.id!;
        removeFromCart(id);
      });
    });

    document.querySelectorAll(".drawer-increase").forEach((btn) => {
      btn.addEventListener("click", (e) => {
        const id = (e.currentTarget as HTMLElement).dataset.id!;
        const item = cart.find((i) => String(i.id) === id);
        if (item) addToCart(item);
      });
    });
  });
</script>
