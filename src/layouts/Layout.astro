---
import Header from "../components/Header.astro";
import Footer from "../components/Footer.astro";
import CartDrawer from "../components/CartDrawer.astro";
import "../styles/global.css";

interface Props {
  title?: string;
  hideHeaderFooter?: boolean;
}

const { title = "Bean Scene", hideHeaderFooter = false } = Astro.props;
const pathname = Astro.url.pathname;
const shouldHideHeaderFooter =
  hideHeaderFooter || pathname === "/login" || pathname === "/success";
---

<!doctype html>
<html lang="en" class="scroll-smooth">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width" />
    <link rel="icon" href="/icon.svg" />
    <meta name="generator" content={Astro.generator} />
    <title>{title}</title>
  </head>
  <body>
    {shouldHideHeaderFooter ? null : <Header />}
    <slot />
    {shouldHideHeaderFooter ? null : <Footer />}

    <CartDrawer />
  </body>
</html>
