---
import cup from "@assets/coffee-cup.png";
import Button from "@components/Button.astro";
import Image from "astro/components/Image.astro";
---

<section class="h-fit" id="Menu">
  <div class="flex w-full items-center gap-16 px-16">
    <div class="flex flex-col gap-y-7 max-w-[585px]">
      <h2 class="text-(--header-color) text-[54px] font-semibold">
        Discover the best coffee
      </h2>
      <p class="text-(--text-color)">
        Bean Scene is a coffee shop that provides you with quality coffee that
        helps boost your productivity and helps build your mood. Having a cup of
        coffee is good, but having a cup of real coffee is greater. There is no
        doubt that you will enjoy this coffee more than others you have ever
        tasted.
      </p>
      <Button width="134px" fontWeight="500"> Learn More </Button>
    </div>
    <Image
      src={cup}
      alt="Cup of coffee"
      class="w-[494px] max-w-full h-auto object-contain ml-auto"
    />
  </div>
</section>
