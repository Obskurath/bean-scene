---
import coffeeImage from "@assets/coffee_image.png";
import Button from "@components/Button.astro";
---

<main
  id="section-hero"
  class="relative min-h-dvh w-full overflow-hidden bg-cover bg-center bg-no-repeat"
  style={`background-image: url(${coffeeImage.src});`}
>
  <div
    class="absolute inset-0 bg-linear-to-r from-black/65 via-black/30 to-black/0"
  >
    <p>We,ve got your morning covered with</p>
    <h1>Coffee</h1>
    <p>
      It is best to start your day with a cup of coffee you will ever have, We
      provide the best for our customers.
    </p>
    <Button href="/order" width="134px" height="48px">Order Now</Button>
  </div>
</main>
