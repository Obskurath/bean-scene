---
import coffeeImage from "@assets/coffee_image.png";
import Button from "@components/Button.astro";
---

<main
  id="Home"
  class="relative min-h-screen w-full overflow-y-auto bg-cover bg-no-repeat"
  style={`background-image: url(${coffeeImage.src});`}
>
  <div
    class="min-h-screen bg-linear-to-r from-black/85 via-black/10 to-black/0"
  >
    <div class="flex flex-col px-16 pt-24 pb-10 lg:pt-40">
      <p class="text-[22px] font-extralight mt-6">
        We,ve got your morning covered with
      </p>
      <div class="flex flex-col gap-8 font-heading-light w-[550px]">
        <h1 class="text-[220px] font-script leading-tight">Coffee</h1>
        <p class="text-[20px] font-extralight">
          It is best to start your day with a cup of coffee. Discover the best
          flavours coffee you will ever have. We provide the best for our
          customers.
        </p>
        <Button href="/order" width="134px" height="48px" fontWeight="700"
          >Order Now</Button
        >
      </div>
    </div>
  </div>
</main>
