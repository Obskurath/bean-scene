---
import coffeeImage from "@assets/coffee_image.png";
import Button from "@components/Button.astro";
---

<main
  id="Home"
  class="relative min-h-dvh w-full overflow-hidden bg-cover bg-no-repeat"
  style={`background-image: url(${coffeeImage.src});`}
>
  <div
    class="absolute inset-0 bg-linear-to-r from-black/90 via-black/30 to-black/0"
  >
    <div class="container max-w-137.5 flex flex-col mt-44 ml-16">
      <p class="text-[22px] font-extralight">
        We,ve got your morning covered with
      </p>
      <div class="flex flex-col gap-6 font-heading-light">
        <h class="text-[220px] font-script leading-tight">Coffee</h>
        <p class="text-[20px] font-extralight">
          It is best to start your day with a cup of coffee. Discover the best
          flavours coffee you will ever have. We provide the best for our
          customers.
        </p>
        <Button href="/order" width="134px" height="48px" fontWeight="700"
          >Order Now</Button
        >
      </div>
    </div>
  </div>
</main>
