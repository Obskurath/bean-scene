---
import Card from "@components/Card.astro";
import beans from "@assets/coffee-beans.svg";
import badge from "@assets/badge.svg";
import coffee from "@assets/coffee-cup.svg";
import price from "@assets/best-price.svg";
import Button from "@components/Button.astro";

const contentData = [
  {
    id: "1",
    title: "Supreme Beans",
    description: "Beans that provides great taste",
    icon: beans,
  },
  {
    id: "2",
    title: "High Quality",
    description: "We provide the highest quality",
    icon: badge,
  },
  {
    id: "3",
    title: "Extraordinary",
    description: "Coffee like you have never tasted",
    icon: coffee,
  },
  {
    id: "4",
    title: "Affordable Price",
    description: "Our Coffee prices are easy to afford",
    icon: price,
  },
];
---

<section
  class="max-w-6xl mx-auto px-4 py-16 flex flex-col items-center"
  id="About"
>
  <div class="text-center mb-12">
    <h2
      class="text-3xl sm:text-4xl md:text-5xl font-bold text-(--header-color) mb-4"
    >
      Why are we different?
    </h2>
    <p class="text-(--text-color) text-base sm:text-lg max-w-2xl mx-auto">
      We don't just make your coffee, we make your day!
    </p>
  </div>

  <!-- Grid optimizado para que en celular de 2 columnas los elementos respiren mejor -->
  <div class="grid grid-cols-2 lg:grid-cols-4 gap-4 sm:gap-6 w-full">
    {contentData.map((item) => <Card content={item} />)}
  </div>

  <p
    class="text-(--text-color) text-base sm:text-lg max-w-2xl mx-auto mt-10 mb-1 sm:text-[20px] text-center px-4"
  >
    Great ideas start with great coffee. Lets help you achieve that
  </p>
  <h3 class="text-2xl sm:text-[30px] font-bold text-(--header-color) mb-4">
    Get started today.
  </h3>
  <Button fontWeight="500">Join Us</Button>
</section>
