---
import ProductCard from "@components/ProductCard.astro";
import { getProducts } from "../lib/products";

const productsData = await getProducts();
---

<section
  class="max-w-6xl mx-auto px-4 py-16 flex flex-col items-center"
  id="Menu"
>
  <div class="text-center mb-12">
    <h2 class="text-4xl md:text-5xl font-bold text-(--header-color) mb-4">
      Enjoy a new blend of coffee style
    </h2>
    <p class="text-(--text-color) text-lg max-w-2xl mx-auto">
      Explore all flavours of coffee with us. There is always a new cup worth
      experiencing
    </p>
  </div>

  <div class="grid grid-cols-2 sm:grid-cols-3 lg:grid-cols-4 gap-6 w-full">
    {productsData.map((product) => <ProductCard product={product} />)}
  </div>
</section>
