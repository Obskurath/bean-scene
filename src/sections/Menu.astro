---
import ProductCard from "@components/ProductCard.astro";
import { supabase } from "../lib/supabase";

const { data: productsSupabase, error } = await supabase
  .from("productos")
  .select("*");

if (error) {
  console.error("Error loading products from Supabase:", error.message);
}

const productsData = (productsSupabase || []).map((item) => ({
  id: item.id,
  name: item.nombre,
  description: item.descripcion,
  price: Number(item.precio),
  image: item.imagen_url,
}));
---

<section
  class="max-w-6xl mx-auto px-4 py-16 flex flex-col items-center"
  id="Menu"
>
  <div class="text-center mb-12">
    <h2
      class="text-4xl md:text-5xl font-bold text-(--header-color) font-serif mb-4"
    >
      Enjoy a new blend of coffee style
    </h2>
    <p class="text-(--text-color) text-lg max-w-2xl mx-auto">
      Explore all flavours of coffee with us. There is always a new cup worth
      experiencing
    </p>
  </div>

  <div class="grid grid-cols-1 sm:grid-cols-2 lg:grid-cols-4 gap-6 w-full">
    {productsData.map((product) => <ProductCard product={product} />)}
  </div>
</section>
