---
import Layout from "../layouts/Layout.astro";
import coffeeImage from "../assets/coffee_image.png";
import Button from "../components/Button.astro";
---

<Layout title="Sign Up | Bean Scene" hideHeaderFooter={true}>
  <main
    class="h-dvh overflow-hidden bg-(--filler-color) flex items-center justify-center px-4 py-8 sm:px-6 lg:px-8"
  >
    <div class="w-full max-w-6xl flex items-center justify-center">
      <div
        class="grid w-full overflow-hidden rounded-4xl border border-(--border-color)/40 bg-white shadow-[0_25px_80px_rgba(96,56,9,0.16)] lg:grid-cols-[1.05fr_0.95fr]"
      >
        <section class="relative hidden lg:block">
          <img
            src={coffeeImage.src}
            alt="Bean Scene Coffee"
            class="h-full w-full object-cover"
          />
          <div
            class="absolute inset-0 bg-linear-to-r from-black/75 via-black/20 to-transparent"
          >
          </div>
          <div
            class="absolute inset-0 flex flex-col justify-end p-10 text-white"
          >
            <p class="font-script text-4xl">Bean Scene</p>
            <h2 class="mt-2 max-w-sm text-3xl font-semibold leading-tight">
              Start your coffee journey
            </h2>
            <p class="mt-3 max-w-sm text-sm leading-6 text-white/80">
              Join us to experience the best artisanal coffee, track your
              orders, and earn exclusive rewards.
            </p>
          </div>
        </section>

        <section
          class="flex items-center justify-center bg-(--filler-color) p-8 sm:p-10 lg:p-12"
        >
          <div class="w-full max-w-md">
            <div class="mb-8 text-center">
              <img
                src="/icon.svg"
                alt="Logo"
                class="mx-auto mb-3 h-14 w-auto"
              />
              <h1 class="font-script text-4xl text-(--header-color)">
                Create an account
              </h1>
              <p class="mt-2 text-sm leading-6 text-(--text-color)">
                Sign up to start enjoying your favorite coffee routine.
              </p>
            </div>

            <form id="signup-form" class="space-y-5">
              <div>
                <label
                  for="full-name"
                  class="mb-2 block text-sm font-semibold text-(--header-color)"
                >
                  Full Name
                </label>
                <input
                  type="text"
                  id="full-name"
                  name="full-name"
                  required
                  class="block w-full rounded-full border border-(--border-color)/50 bg-white px-4 py-3 text-(--header-color) placeholder:text-gray-400 shadow-sm outline-none transition focus:border-(--btn-color) focus:ring-2 focus:ring-(--btn-color)/40"
                  placeholder="Eduardo Valencia"
                />
              </div>

              <div>
                <label
                  for="email"
                  class="mb-2 block text-sm font-semibold text-(--header-color)"
                >
                  Email
                </label>
                <input
                  type="email"
                  id="email"
                  name="email"
                  required
                  class="block w-full rounded-full border border-(--border-color)/50 bg-white px-4 py-3 text-(--header-color) placeholder:text-gray-400 shadow-sm outline-none transition focus:border-(--btn-color) focus:ring-2 focus:ring-(--btn-color)/40"
                  placeholder="you@email.com"
                />
              </div>

              <div>
                <label
                  for="password"
                  class="mb-2 block text-sm font-semibold text-(--header-color)"
                >
                  Password
                </label>
                <input
                  type="password"
                  id="password"
                  name="password"
                  required
                  minlength="6"
                  class="block w-full rounded-full border border-(--border-color)/50 bg-white px-4 py-3 text-(--header-color) placeholder:text-gray-400 shadow-sm outline-none transition focus:border-(--btn-color) focus:ring-2 focus:ring-(--btn-color)/40"
                  placeholder="••••••••"
                />
              </div>

              <div class="mt-2">
                <Button type="submit" width="100%" class="w-full">
                  SIGN UP
                </Button>
              </div>
            </form>

            <div class="mt-6 text-center text-sm text-(--text-color)">
              Already have an account?
              <a
                href="/sign-in"
                class="ml-1 font-semibold text-(--header-color) transition hover:text-(--btn-color)"
              >
                Sign in here
              </a>
            </div>
          </div>
        </section>
      </div>
    </div>
  </main>
</Layout>

<script>
  import { supabase } from "../lib/supabase";
  import Swal from "sweetalert2";

  const form = document.getElementById("signup-form") as HTMLFormElement;

  form?.addEventListener("submit", async (e) => {
    e.preventDefault();

    const formData = new FormData(form);
    const email = formData.get("email") as string;
    const password = formData.get("password") as string;
    const fullName = formData.get("full-name") as string;

    const redirectUrl = `${window.location.origin}/`;

    const { data, error } = await supabase.auth.signUp({
      email: email,
      password: password,
      options: {
        data: {
          full_name: fullName,
        },
        emailRedirectTo: redirectUrl,
      },
    });

    if (error) {
      Swal.fire({
        icon: "error",
        title: "Oops...",
        text: error.message,
        confirmButtonColor: "var(--btn-color)",
        background: "var(--filler-color)",
        color: "var(--text-color)",
        customClass: {
          popup: "border border-[var(--border-color)] rounded-3xl shadow-xl",
          confirmButton:
            "rounded-full px-6 py-2.5 font-semibold text-white tracking-wider",
        },
      });
      console.error("Sign up error:", error.message);
    } else {
      Swal.fire({
        icon: "success",
        title: "Account created!",
        text: "Welcome to Bean Scene.",
        timer: 2200,
        showConfirmButton: false,
        background: "var(--filler-color)",
        color: "var(--header-color)",
        customClass: {
          popup: "border border-[var(--border-color)] rounded-3xl shadow-xl",
        },
      }).then(() => {
        window.location.href = "/";
      });
    }
  });
</script>
